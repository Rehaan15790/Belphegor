# Docker settings. Copy this file to .env and set POSTGRES_PASSWORD.
POSTGRES_USER=belphegor
POSTGRES_PASSWORD=
POSTGRES_DB=belphegor

# LLM: set one key, or leave both blank and add it later in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BELPHEGOR_LLM_PROVIDER=
BELPHEGOR_LLM_MODEL=
BELPHEGOR_LLM_BASE_URL=
BELPHEGOR_LLM_PROXY=

# First run: /setup asks for a random token printed in the log (docker compose logs belphegor).
# BELPHEGOR_SETUP_TOKEN sets that token yourself. BELPHEGOR_ADMIN_PASSWORD (8+ characters) skips /setup.
BELPHEGOR_SETUP_TOKEN=
BELPHEGOR_ADMIN_PASSWORD=

# Extra browser origins allowed to call the API (comma separated). The built-in UI needs none.
BELPHEGOR_CORS_ORIGINS=
